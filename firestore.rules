rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pay ID directory: look up one name at a time. No listing, no edits, no deletes.
    match /payids/{id} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && id.matches('^[a-z0-9_.]{3,20}$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'addr', 'created', 'aleoAddr'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.addr is string && request.resource.data.addr.size() <= 80;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aleoAddr'])
        && request.resource.data.aleoAddr is string && request.resource.data.aleoAddr.size() <= 80;
      allow delete: if false;
    }
    // Demo transfers (test money only). Only sender and recipient can read; recipient can mark as claimed.
    match /transfers/{tid} {
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.claimed == false
        && request.resource.data.amount is number
        && request.resource.data.amount > 0 && request.resource.data.amount <= 100000
        && request.resource.data.keys().hasOnly(['fromUid', 'toUid', 'from', 'to', 'amount', 'note', 'ts', 'claimed']);
      allow read: if request.auth != null
        && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      allow update: if request.auth != null
        && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed']);
      allow delete: if false;
    }
  }
}
